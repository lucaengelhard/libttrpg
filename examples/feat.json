{
  "type": "FEAT",
  "boons": {
    "type": "MULTIPLE",
    "values": [
      {
        "type": "MODIFIER",
        "value": { "type": "DERIVED", "from": "$CHARACTER.STATS.INT + 3" },
        "sets": "$CHARACTER.AC"
      },
      { "type": "MODIFIER", "value": 3 },
      {
        "type": "MODIFIER",
        "value": {
          "type": "BINOP",
          "binopType": "MAX",
          "a": 3,
          "b": { "type": "DERIVED", "from": "$CHARACTER.PROFICIENCY" }
        },
        "modifies": "$CHARACTER.HP"
      }
    ]
  }
}
